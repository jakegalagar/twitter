<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <.live_title default="Twitter" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    
<!-- theme script (unchanged) -->
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) =>
          e.key === "phx:theme" && setTheme(e.newValue || "system")
        );
        window.addEventListener("phx:set-theme", (e) =>
          setTheme(e.target.dataset.phxTheme)
        );
      })();
    </script>
  </head>

  <body class="bg-base-100 font-sans">
    
<!-- OUTER 3-COLUMN TWITTER LAYOUT -->
    <div class="mx-auto max-w-7xl grid grid-cols-12 gap-4 px-4">
      
<!-- LEFT NAVIGATION (Twitter sidebar) -->
      <aside class="col-span-2 hidden lg:block sticky top-0 h-screen pt-8">
        <ul class="menu bg-base-100 w-full gap-4 text-lg">
          <li class="font-bold text-2xl px-2 mb-4">Twitter</li>

          <%= if @current_scope do %>
            <li class="px-2 opacity-60">
              {@current_scope.user.email}
            </li>

            <li><.link href={~p"/tweets"}>Tweets</.link></li>
            <li><.link href={~p"/users"}>Users</.link></li>
            <li><.link href={~p"/users/settings"}>Settings</.link></li>
            <li><.link href={~p"/users/log-out"} method="delete">Log out</.link></li>

            <li class="mt-6">
              <.link href={~p"/tweets/new"} class="btn btn-primary w-full">
                Tweet
              </.link>
            </li>
          <% else %>
            <li><.link href={~p"/users/register"}>Register</.link></li>
            <li><.link href={~p"/users/log-in"}>Log in</.link></li>
          <% end %>
        </ul>
      </aside>
      
<!-- MAIN TIMELINE CONTENT -->
      <main class="col-span-12 lg:col-span-7 border-x border-base-300 min-h-screen">
        {@inner_content}
      </main>
      
<!-- RIGHT SIDEBAR (Only on XL screens) -->
      <aside class="col-span-3 hidden xl:block sticky top-0 h-screen pt-8 space-y-4">
        
<!-- Search bar -->
        <label class="input input-bordered flex items-center gap-2 w-full">
          🔍 <input type="text" placeholder="Search Twitter" class="grow" />
        </label>
        
<!-- Trends -->
        <div class="card bg-base-200 shadow">
          <div class="card-body">
            <h2 class="card-title">Trends for you</h2>
            <ul class="menu">
              <li><a>#Elixir</a></li>
              <li><a>#PhoenixLiveView</a></li>
              <li><a>#DaisyUI</a></li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
    
<!-- MOBILE BOTTOM NAV (like Twitter) -->
    <nav class="fixed bottom-0 left-0 right-0 border-t border-base-300 bg-base-100 p-2 flex justify-around lg:hidden">
      <.link href={~p"/tweets"} class="btn btn-ghost">🏠</.link>
      <.link href="#" class="btn btn-ghost">🔍</.link>
      <.link href="#" class="btn btn-ghost">🔔</.link>
      <.link href={~p"/users"} class="btn btn-ghost">👤</.link>
    </nav>
  </body>
</html>
